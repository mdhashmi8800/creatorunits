{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatorunits",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true
  }
}
