{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creatorunits",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // Smart placement: Cloudflare automatically places the Worker in the
  // region closest to your data sources to minimize latency.
  "placement": {
    "mode": "smart"
  }
}
