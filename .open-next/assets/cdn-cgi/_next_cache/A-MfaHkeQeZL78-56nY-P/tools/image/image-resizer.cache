times.\",\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"margin\":0},\"children\":\"PNG to WebP Converter\"}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.8rem\",\"margin\":0,\"flexGrow\":1,\"overflow\":\"hidden\",\"textOverflow\":\"ellipsis\",\"display\":\"-webkit-box\",\"WebkitLineClamp\":2,\"WebkitBoxOrient\":\"vertical\"},\"children\":\"Convert PNG graphics to modern WebP format to reduce web loading times.\"}]]}],[\"$\",\"$L8\",\"img-webp-to-jpg\",{\"href\":\"/tools/image/webp-to-jpg-converter\",\"className\":\"card card-hover flex flex-col gap-2\",\"style\":{\"textDecoration\":\"none\",\"color\":\"inherit\",\"padding\":\"1.25rem\"},\"aria-label\":\"Open WebP to JPG Converter - Convert next-gen WebP images back into widely compatible JPG files.\",\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"margin\":0},\"children\":\"WebP to JPG Converter\"}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.8rem\",\"margin\":0,\"flexGrow\":1,\"overflow\":\"hidden\",\"textOverflow\":\"ellipsis\",\"display\":\"-webkit-box\",\"WebkitLineClamp\":2,\"WebkitBoxOrient\":\"vertical\"},\"children\":\"Convert next-gen WebP images back into widely compatible JPG files.\"}]]}]]}]]}]\n24:[\"$\",\"details\",\"4\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"Will resizing affect image quality?\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"Downscaling an image to smaller dimensions preserves clarity, although it contains fewer pixels. However, upscaling an image beyond its original dimensions will cause pixelation and blurriness, so we recommend starting with high-resolution source files. Having the correct pixel sizes prevents layout stretching and guarantees a clean, high-quality display on websites.\"}]]}]\n25:[\"$\",\"details\",\"5\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"Can I resize multiple images?\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"Currently, our tool is optimized to resize one image at a time to ensure maximum speed and precision. This allows you to fine-tune the exact dimensions, review the real-time quality output, check the aspect ratio lock, and download each adjusted file individually without overloading your browser's local memory or risking design distortion.\"}]]}]\n26:[\"$\",\"details\",\"6\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"Is image resizing free?\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"Yes, our image resizer is completely free to use. There are no hidden subscription fees, watermark overlays on your downloaded images, or limits on the number of files you can process. You can resize as many files as you need, whenever you want, directly from your desktop or mobile web browser.\"}]]}]\n19:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#ffffff\",\"media\":\"(prefers-color-scheme: light)\"}],[\"$\",\"meta\",\"3\",{\"name\":\"theme-color\",\"content\":\"#000000\",\"media\":\"(prefers-color-scheme: dark)\"}]]\n27:I[6869,[],\"IconMark\"]\n16:null\n1b:[[\"$\",\"title\",\"0\",{\"children\":\"Online Image Resizer - Resize JPG, PNG, WebP Instantly | Creators Units\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Resize JPG, PNG, and WebP images online. Lock aspect ratio, scale by percentage, or enter custom dimensions. Runs entirely in your browser.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"Creators Units\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"creator tools, image compressor, qr generator, youtube tag extractor, text case converter, fancy text generator, link in bio\"}],[\"$\",\"meta\",\"4\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"5\",{\"rel\":\"canonical\",\"href\":\"https://creatorunits.com/tools/image/image-resizer\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Online Image Resizer - Resize JPG, PNG, WebP Instantly | Creators Units\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Resize JPG, PNG, and WebP images online. Lock aspect ratio, scale by percentage, or enter custom dimensions. Runs entirely in your browser.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\