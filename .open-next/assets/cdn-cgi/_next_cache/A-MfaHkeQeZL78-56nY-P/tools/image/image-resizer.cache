 to use. There are no hidden subscription fees, watermark overlays on your downloaded images, or limits on the number of files you can process. You can resize as many files as you need, whenever you want, directly from your desktop or mobile web browser.\"}]]}]\n","/tools/$d$category/$d$slug":"1:I[7121,[],\"LoadingBoundaryProvider\"]\n2:\"$Sreact.fragment\"\n3:I[7121,[],\"\"]\n4:I[4581,[],\"\"]\n5:[]\n0:{\"rsc\":[\"$\",\"$L1\",null,{\"loading\":[[\"$\",\"main\",\"l\",{\"className\":\"main-content section\",\"id\":\"main-content\",\"aria-label\":\"Loading tool\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"style\":{\"display\":\"flex\",\"gap\":\"0.5rem\",\"marginBottom\":\"1rem\",\"alignItems\":\"center\"},\"aria-hidden\":\"true\",\"children\":[[\"$\",\"div\",null,{\"className\":\"skeleton\",\"style\":{\"width\":\"3rem\",\"height\":\"0.875rem\",\"borderRadius\":\"4px\"}}],[\"$\",\"span\",null,{\"style\":{\"color\":\"var(--text-muted)\",\"fontSize\":\"0.85rem\"},\"children\":\"/\"}],[\"$\",\"div\",null,{\"className\":\"skeleton\",\"style\":{\"width\":\"5rem\",\"height\":\"0.875rem\",\"borderRadius\":\"4px\"}}],[\"$\",\"span\",null,{\"style\":{\"color\":\"var(--text-muted)\",\"fontSize\":\"0.85rem\"},\"children\":\"/\"}],[\"$\",\"div\",null,{\"className\":\"skeleton\",\"style\":{\"width\":\"8rem\",\"height\":\"0.875rem\",\"borderRadius\":\"4px\"}}]]}],[\"$\",\"div\",null,{\"style\":{\"marginBottom\":\"2rem\"},\"aria-hidden\":\"true\",\"children\":[[\"$\",\"div\",null,{\"className\":\"skeleton\",\"style\":{\"width\":\"60%\",\"height\":\"2.25rem\",\"borderRadius\":\"6px\",\"marginBottom\":\"0.75rem\"}}],[\"$\",\"div\",null,{\"className\":\"skeleton\",\"style\":{\"width\":\"80%\",\"height\":\"1.05rem\",\"borderRadius\":\"4px\"}}]]}],[\"$\",\"div\",null,{\"className\":\"skeleton card\",\"style\":{\"minHeight\":\"420px\",\"marginBottom\":\"3rem\",\"border\":\"none\"},\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"cla