el for=\"tools-search\" class=\"sr-only\">Search tools</label><input id=\"tools-search\" type=\"text\" placeholder=\"Search tools by name or description...\" class=\"form-control\" aria-label=\"Search tools by name or description\" value=\"\"/></div><div role=\"tablist\" aria-label=\"Filter tools by category\" style=\"display:flex;gap:0.5rem;flex-wrap:wrap;border-bottom:1px solid var(--border-color);padding-bottom:0.75rem\"><button role=\"tab\" aria-selected=\"true\" aria-controls=\"tools-panel\" id=\"tab-all\" class=\"btn btn-primary btn-sm\">All Tools (<!-- -->33<!-- -->)</button><button role=\"tab\" aria-selected=\"false\" aria-controls=\"tools-panel\" id=\"tab-image\" class=\"btn btn-secondary btn-sm\">Image Tools<!-- --> (<!-- -->10<!-- -->)</button><button role=\"tab\" aria-selected=\"false\" aria-controls=\"tools-panel\" id=\"tab-creator\" class=\"btn btn-secondary btn-sm\">Creator Tools<!-- --> (<!-- -->7<!-- -->)</button><button role=\"tab\" aria-selected=\"false\" aria-controls=\"tools-panel\" id=\"tab-social\" class=\"btn btn-secondary btn-sm\">Social Media Tools<!-- --> (<!-- -->8<!-- -->)</button><button role=\"tab\" aria-selected=\"false\" aria-controls=\"tools-panel\" id=\"tab-utility\" class=\"btn btn-secondary btn-sm\">Utility Tools<!-- --> (<!-- -->8<!-- -->)</button></div></div></div><div id=\"tools-panel\" role=\"tabpanel\" aria-labelledby=\"tab-all\"><div class=\"grid-cols-3\"><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Image Compressor - Compress PNG, JPG, and WebP images directly in your browser without losing quality.\" href=\"/tools/image/image-compressor\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">Image Compressor</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Compress PNG, JPG, and WebP images directly in your browser without losing quality.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Image Resizer - Resize images to custom pixel dimensions or preset percentages with aspect ratio lock.\" href=\"/tools/image/image-resizer\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">Image Resizer</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Resize images to custom pixel dimensions or preset percentages with aspect ratio lock.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open JPG to PNG Converter - Convert JPG/JPEG images to PNG format instantly while maintaining original quality.\" href=\"/tools/image/jpg-to-png-converter\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">JPG to PNG Converter</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Convert JPG/JPEG images to PNG format instantly while maintaining original quality.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open PNG to WebP Converter - Convert PNG graphics to modern WebP format to reduce web loading times.\" href=\"/tools/image/png-to-webp-converter\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">PNG to WebP Converter</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Convert PNG graphics to modern WebP format to reduce web loading times.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open WebP to JPG Converter - Convert next-gen WebP images back into widely compatible JPG files.\" href=\"/tools/image/webp-to-jpg-converter\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">WebP to JPG Converter</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Convert next-gen WebP images back into widely compatible JPG files.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Image Cropper - Crop images to specific ratios like 16:9, 1:1, 4:3, or custom shapes instantly.\" href=\"/tools/image/image-cropper\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">Image Cropper</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Crop images to specific ratios like 16:9, 1:1, 4:3, or custom shapes instantly.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Image Rotator - Rotate your images 90°, 180°, or 270° clockwise or counter-clockwise.\" href=\"/tools/image/image-rotator\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">Image Rotator</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Rotate your images 90°, 180°, or 270° clockwise or counter-clockwise.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Image Flipper - Mirror images horizontally or vertically to correct mirroring issues.\" href=\"/tools/image/image-flipper\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">Image Flipper</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Mirror images horizontally or vertically to correct mirroring issues.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Color Picker &amp; Extractor - Extract colors from images or use the visual palette builder to get HEX/RGB codes.\" href=\"/tools/image/color-picker\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">Color Picker &amp; Extractor</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Extract colors from images or use the visual palette builder to get HEX/RGB codes.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Screenshot Beautifier - Transform raw screenshots into beautiful, shareable marketing graphics with margins and shadow.\" href=\"/tools/image/screenshot-cleaner\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Image Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">Screenshot Beautifier</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Transform raw screenshots into beautiful, shareable marketing graphics with margins and shadow.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open YouTube Thumbnail Preview - Preview your video thumbnails inside simulated YouTube search, homepage, and sidebar widgets.\" href=\"/tools/creator/youtube-thumbnail-preview\"><div class=\"flex justify-between items-start\"><span class=\"badge badge-accent\" style=\"font-size:0.65rem\">Creator Tools</span></div><h3 style=\"font-size:1.2rem;margin:0\">YouTube Thumbnail Preview</h3><p class=\"text-muted\" style=\"font-size:0.875rem;margin:0;flex-grow:1;line-height:1.4\">Preview your video thumbnails inside simulated YouTube search, homepage, and sidebar widgets.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open YouTube Thumbnail Downloader - Retrieve and download all available resolutions of a YouTube thumbnail from its video link.\" href=\"/tools/creator/thumbnail-downloader\"><div class=\"flex justify-between items-start\"><span class=\"badge badg