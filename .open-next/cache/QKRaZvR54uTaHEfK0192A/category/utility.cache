type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Creators Units\",\"url\":\"https://creatorunits.com\",\"description\":\"Free online tools for creators, freelancers, and small businesses.\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://creatorunits.com/tools?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}}</script><script>\n              (function() {\n                try {\n                  const savedTheme = localStorage.getItem('theme');\n                  const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n                  const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');\n                  document.documentElement.setAttribute('data-theme', theme);\n                } catch (e) {}\n              })();\n            </script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div style=\"visibility:hidden\" class=\"page-wrapper\"><a href=\"#main-content\" class=\"skip-to-content\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://creatorunits.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Utility Tools\",\"item\":\"https://creatorunits.com/category/utility\"}]}</script><header class=\"Header-module__lnUIdW__header\" role=\"banner\"><div class=\"Header-module__lnUIdW__nav container\"><a class=\"Header-module__lnUIdW__logo\" aria-label=\"Creators Units - Go to homepage\" href=\"/\"><svg class=\"Header-module__lnUIdW__logoIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"8\" height=\"18\" rx=\"2\"></rect><rect x=\"13\" y=\"3\" width=\"8\" height=\"8\" rx=\"2\"></rect><rect x=\"13\" y=\"13\" width=\"8\" height=\"8\" rx=\"2\"></rect></svg><span class=\"Header-module__lnUIdW__logoText\">Creators Units</span></a><nav class=\"Header-module__lnUIdW__menu\" aria-label=\"Main navigation\"><a class=\"Header-module__lnUIdW__link \" href=\"/tools\">Explore Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/category/image\">Image Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/category/creator\">Creator Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/category/social\">Social Tools</a><a class=\"Header-module__lnUIdW__link Header-module__lnUIdW__linkActive\" aria-current=\"page\" href=\"/category/utility\">Utility Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/about\">About</a><a class=\"Header-module__lnUIdW__link \" href=\"/contact\">Contact</a></nav><div class=\"Header-module__lnUIdW__actions\"><button class=\"Header-module__lnUIdW__themeToggle\" aria-label=\"Switch to dark mode\" title=\"Toggle to dark theme\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"></path></svg></button><button class=\"Header-module__lnUIdW__menuToggle\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-nav\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button></div></div></header><main class=\"main-content section\" id=\"main-content\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" style=\"margin-bottom:1rem;font-size:0.85rem\"><ol style=\"display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:0;align-items:center\"><li><a style=\"color:var(--text-muted);text-decoration:none\" href=\"/\">Home</a></li><li aria-hidden=\"true\" style=\"margin:0 0.5rem;color:var(--text-muted)\">/</li><li aria-current=\"page\" style=\"color:var(--text-primary);font-weight:600\">Utility Tools</li></ol></nav><div class=\"card\" style=\"margin-bottom:2.5rem;padding:2rem\"><h1 style=\"font-size:2.25rem;margin-bottom:0.75rem\">Utility Tools</h1><p class=\"text-muted\" style=\"font-size:1.05rem;margin:0;line-height:1.5\">Create QR codes, build UTM links, convert case, count words, and calculate units.</p></div><div class=\"grid-cols-3\" style=\"margin-bottom:3rem\"><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open QR Code Generator - Generate standard QR codes for URLs, text, or Wi-Fi configurations.\" href=\"/tools/utility/qr-code-generator\"><h2 style=\"font-size:1.15rem;margin:0\">QR Code Generator</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Generate standard QR codes for URLs, text, or Wi-Fi configurations.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open URL Encoder / Decoder - Encode or decode strings to ensure safe transmission within query parameters.\" href=\"/tools/utility/url-encoder-decoder\"><h2 style=\"font-size:1.15rem;margin:0\">URL Encoder / Decoder</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Encode or decode strings to ensure safe transmission within query parameters.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open UTM Campaign Builder - Build marketing campaign links with source, medium, and term tracking codes.\" href=\"/tools/utility/utm-builder\"><h2 style=\"font-size:1.15rem;margin:0\">UTM Campaign Builder</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Build marketing campaign links with source, medium, and term tracking codes.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Secure Password Generator - Create cryptographically secure, random passwords with custom rules.\" href=\"/tools/utility/password-generator\"><h2 style=\"font-size:1.15rem;margin:0\">Secure Password Generator</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Create cryptographically secure, random passwords with custom rules.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Text Case Converter - Convert text formats: UPPERCASE, lowercase, Title Case, Sentence Case, or slugify.\" href=\"/tools/utility/text-case-converter\"><h2 style=\"font-size:1.15rem;margin:0\">Text Case Converter</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Convert text formats: UPPERCASE, lowercase, Title Case, Sentence Case, or slugify.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Word &amp; Sentence Counter - Measure word count, character count, keyword density, and estimated reading time.\" href=\"/tools/utility/word-counter\"><h2 style=\"font-size:1.15rem;margin:0\">Word &amp; Sentence Counter</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Measure word count, character count, keyword density, and estimated reading time.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Quick Units Converter - Convert units of length, mass, temperature, area, volume, and data sizes.\" href=\"/tools/utility/units-converter\"><h2 style=\"font-size:1.15rem;margin:0\">Quick Units Converter</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Convert units of length, mass, temperature, area, volume, and data sizes.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a><a class=\"card card-hover flex flex-col gap-3\" style=\"text-decoration:none;color:inherit\" aria-label=\"Open Time &amp; Timezone Converter - Convert UTC to local time, convert timestamps, and translate world timezones.\" href=\"/tools/utility/time-converter\"><h2 style=\"font-size:1.15rem;margin:0\">Time &amp; Timezone Converter</h2><p class=\"text-muted\" style=\"font-size:0.85rem;margin:0;flex-grow:1;line-height:1.4\">Convert UTC to local time, convert timestamps, and translate world timezones.</p><span class=\"text-primary-color\" style=\"font-size:0.85rem;font-weight:600;margin-top:0.5rem\">Open Tool →</span></a></div><section class=\"card\" style=\"background-color:var(--bg-primary);padding:2rem\"><h2 style=\"font-size:1.5rem;margin-bottom:1rem\">About Our <!-- -->Utility Tools<!-- --> Suite</h2><div style=\"font-size:0.95rem;color:var(--text-secondary);line-height:1.6;display:flex;flex-direction:column;gap:1rem\"><p>Tackle standard daily office and web tasks quickly. Creators Units utility tools provide secure cryptographic password generators, URL encoders, UTM tracking link composers, text case formatters, word counter diagnostics, timezone comparisons, and basic unit calculators.</p><p>All utilities operate inside the client browser. No registration is required. Bookmark this index page to speed up your daily creation, design, and posting workloads.</p></div></section></div></main><footer class=\"Footer-module__3hUVsW__footer\"><div class=\"container\"><div class=\"Footer-module__3hUVsW__grid\"><div class=\"Footer-module__3hUVsW__brandCol\"><a class=\"Footer-module__3hUVsW__logo\" aria-label=\"Creators Units - Go to homepage\" href=\"/\"><svg class=\"Footer-module__3hUVsW__logoIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"8\" height=\"18\" rx=\"2\"></rect><rect x=\"13\" y=\"3\" width=\"8\" height=\"8\" rx=\"2\"></rect><rect x=\"13\" y=\"13\" width=\"8\" height=\"8\" rx=\"2\"></rect></svg><span class=\"Footer-module__3hUVsW__logoText\">Creators Units</span></a><p class=\"Footer-module__3hUVsW__tagline\">Free, fast, and secure online tools that help you design, optimize, and grow your digital presence. No installation required.</p></div><div><h3 class=\"Footer-module__3hUVsW__colTitle\">Categories</h3><ul class=\"Footer-module__3hUVsW__linkList\"><li><a class=\"Footer-module__3hUVsW__link\" href=\"/category/image\">Image Tools</a></li><li><a class=\"Footer-module__3hUVsW__link\" href=\"/category/creator\">Creator Tools</a></li><li><a class=\"Footer-module__3hUVsW__link\" href=\"/category/social\">Social Media Tools</a></li><li><a class=\"Footer-module__3hUVsW__link\" href=\"/category/utility\">Utility Tools</a></li></ul></div><div><h3 class=\"Footer-module__3hUVsW__colTitle\">Resources</h3><ul class=\"Footer-module__3hUVsW__linkList\"><li><a class=\"Footer-module__3hUVsW__link\" href=\"/tools\">All Tools</a></li><li><a class=\"Footer-module__3hUVsW__link\" href=\"/about\">About Us</a></li><li><a class=\"Footer-module__3hUVsW__link\" href=\"/contac