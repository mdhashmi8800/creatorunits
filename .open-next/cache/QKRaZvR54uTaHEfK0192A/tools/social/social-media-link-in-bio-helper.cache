\\"800px\\\",\\\"margin\\\":\\\"0 auto\\\"},\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"card\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.05rem\\\",\\\"fontWeight\\\":\\\"600\\\",\\\"cursor\\\":\\\"pointer\\\",\\\"padding\\\":\\\"0.5rem 0\\\",\\\"listStyle\\\":\\\"none\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"space-between\\\",\\\"alignItems\\\":\\\"center\\\"},\\\"children\\\":[\\\"What is a link-in-bio page?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"1.25rem\\\",\\\"color\\\":\\\"var(--success)\\\"},\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"0.9rem\\\",\\\"margin\\\":\\\"0.5rem 0 0 0\\\",\\\"paddingTop\\\":\\\"0.5rem\\\",\\\"borderTop\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"A link-in-bio page is a mobile-responsive landing page that aggregates your important web links, social profiles, shops, and newsletters into a single directory. It resolves social media profile limitations by allowing you to share multiple destinations through one main profile link. It acts as your digital business card, consolidating your online presence into one clean URL.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"card\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.05rem\\\",\\\"fontWeight\\\":\\\"600\\\",\\\"cursor\\\":\\\"pointer\\\",\\\"padding\\\":\\\"0.5rem 0\\\",\\\"listStyle\\\":\\\"none\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"space-between\\\",\\\"alignItems\\\":\\\"center\\\"},\\\"children\\\":[\\\"Why do creators use link-in-bio tools?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"1.25rem\\\",\\\"color\\\":\\\"var(--success)\\\"},\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"0.9rem\\\",\\\"margin\\\":\\\"0.5rem 0 0 0\\\",\\\"paddingTop\\\":\\\"0.5rem\\\",\\\"borderTop\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"Creators use link-in-bio pages to distribute traffic from their social profiles. Since Instagram and TikTok only allow a single clickable link in bios, having a central directory helps creators guide followers to portfolios, affiliate links, merchandising shops, and recent uploads simultaneously. It centralizes your most important destinations, reducing the friction of navigating between platforms.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"card\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"style\\\":{\\\"fontSize\\\":\\\"1.05rem\\\",\\\"fontWeight\\\":\\\"600\\\",\\\"cursor\\\":\\\"pointer\\\",\\\"padding\\\":\\\"0.5rem 0\\\",\\\"listStyle\\\":\\\"none\\\",\\\"display\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"space-between\\\",\\\"alignItems\\\":\\\"center\\\"},\\\"children\\\":[\\\"Can I share multiple links?\\\",[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"1.25rem\\\",\\\"color\\\":\\\"var(--success)\\\"},\\\"children\\\":\\\"+\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted\\\",\\\"style\\\":{\\\"fontSize\\\":\\\"0.9rem\\\",\\\"margin\\\":\\\"0.5rem 0 0 0\\\",\\\"paddingTop\\\":\\\"0.5rem\\\",\\\"borderTop\\\":\\\"1px solid var(--border-color)\\\"},\\\"children\\\":\\\"Yes! Our link-in-bio helper allows you to add as many links as you need. You can customize card titles, icons, and themes. The clean mobile layout ensures viewers can browse and click different links without scrolling through cluttered pages. No more switching out links manually—one page holds everything your audience needs.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"card\\\",\\\"children\\\":[[\\\"$\\\",\\\