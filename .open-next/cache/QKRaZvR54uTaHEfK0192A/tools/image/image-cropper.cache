{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/tools/layout,_N_T_/tools/[category]/layout,_N_T_/tools/[category]/[slug]/layout,_N_T_/tools/[category]/[slug]/page,_N_T_/tools/image/image-cropper"},"segmentPaths":["/_tree","/_full","/tools/$d$category/$d$slug/__PAGE__","/tools/$d$category/$d$slug","/tools/$d$category","/tools","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_29008ace-module__qpOSqq__variable geist_mono_376e4c3c-module__Cf8Oda__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0hwforhb7bb2y.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/3f7c1u3y47an2.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1gb6e7-1asl9f.js\"/><script src=\"/_next/static/chunks/1fj6kbkj_syo6.js\" async=\"\"></script><script src=\"/_next/static/chunks/3j9pm5otqxm82.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2kgwj_ji4063t.js\" async=\"\"></script><script src=\"/_next/static/chunks/119u6-1buly1t.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mrh2-p_w84d.js\" async=\"\"></script><script src=\"/_next/static/chunks/1xk9sgipyme72.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-DBZT1K0P01\" as=\"script\"/><meta name=\"next-size-adjust\" content=\"\"/><title>Free Image Cropper Online - Aspect Ratio Cropping Tool | Creators Units</title><meta name=\"description\" content=\"Crop JPG, PNG, WebP images online. Lock aspect ratios for social media posts or draw custom crops. Client-side canvas cropping.\"/><meta name=\"author\" content=\"Creators Units\"/><meta name=\"keywords\" content=\"creator tools, image compressor, qr generator, youtube tag extractor, text case converter, fancy text generator, link in bio\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://creatorunits.com/tools/image/image-cropper\"/><meta property=\"og:title\" content=\"Free Image Cropper Online - Aspect Ratio Cropping Tool | Creators Units\"/><meta property=\"og:description\" content=\"Crop JPG, PNG, WebP images online. Lock aspect ratios for social media posts or draw custom crops. Client-side canvas cropping.\"/><meta property=\"og:image\" content=\"https://creatorunits.com/og-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Image Cropper - Creators Units\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Free Image Cropper Online - Aspect Ratio Cropping Tool | Creators Units\"/><meta name=\"twitter:description\" content=\"Crop JPG, PNG, WebP images online. Lock aspect ratios for social media posts or draw custom crops. Client-side canvas cropping.\"/><meta name=\"twitter:image\" content=\"https://creatorunits.com/og-image.png\"/><link rel=\"icon\" href=\"/icon.svg\"/><link rel=\"apple-touch-icon\" href=\"/icon.svg\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Creators Units\",\"url\":\"https://creatorunits.com\",\"logo\":\"https://creatorunits.com/logo.png\",\"description\":\"Free, fast, and privacy-focused online tools for creators, freelancers, and small businesses.\",\"sameAs\":[],\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer service\",\"email\":\"support@creatorunits.com\",\"availableLanguage\":\"English\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Creators Units\",\"url\":\"https://creatorunits.com\",\"description\":\"Free online tools for creators, freelancers, and small businesses.\",\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://creatorunits.com/tools?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}}</script><script>\n              (function() {\n                try {\n                  const savedTheme = localStorage.getItem('theme');\n                  const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n                  const theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');\n                  document.documentElement.setAttribute('data-theme', theme);\n                } catch (e) {}\n              })();\n            </script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div style=\"visibility:hidden\" class=\"page-wrapper\"><a href=\"#main-content\" class=\"skip-to-content\">Skip to content</a><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"Image Cropper\",\"url\":\"https://creatorunits.com/tools/image/image-cropper\",\"applicationCategory\":\"UtilityApplication\",\"operatingSystem\":\"All\",\"browserRequirements\":\"Requires HTML5, Javascript, Canvas\",\"description\":\"Crop images to specific ratios like 16:9, 1:1, 4:3, or custom shapes instantly.\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is image cropping?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Image cropping is the process of removing unwanted outer areas from a photo or graphic. It allows you to change the aspect ratio, focus on a specific subject, eliminate distracting background elements, or fit the image into a designated space without stretching or distorting the remaining visual details. It is one of the quickest ways to improve any photograph.\"}},{\"@type\":\"Question\",\"name\":\"Can cropping improve image composition?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, cropping is a powerful tool for improving composition. By removing busy background elements, you can guide the viewer's eye to the main subject. You can apply composition rules, like the rule of thirds, by placing key elements along the gridlines, making your photographs look more professional and engaging. A well-cropped photo instantly draws attention to what matters most.\"}},{\"@type\":\"Question\",\"name\":\"How do I crop images for Instagram?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Instagram supports three main aspect ratios: 1:1 for classic square posts, 4:5 for portrait feeds, and 16:9 for landscape photos. Our image cropper provides simple ratio presets. Select the preset you need, drag the cropping box over your image to frame it, and download the perfectly sized graphic. Your posts will display cleanly without unwanted borders or awkward cropping.\"}},{\"@type\":\"Question\",\"name\":\"Does cropping reduce file size?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, cropping reduces the overall file size of an image. Because you are physically discarding pixels from the edges of the image, the total amount of pixel data decreases. When the crop is exported, the resulting file will contain fewer bytes, making it load faster on websites. This also means less bandwidth usage for your visitors.\"}},{\"@type\":\"Question\",\"name\":\"Can I crop images on mobile devices?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, our image cropper is fully mobile-friendly. You can upload an image from your smartphone or tablet, adjust the crop box using touch controls, zoom in or out, select standard aspect ratios, and download the cropped file directly to your device's photo library using your mobile browser. No app installation is required.\"}},{\"@type\":\"Question\",\"name\":\"Is image cropping permanent?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cropping with our browser-based tool generates a new, cropped copy of your image for you to download. Your original source file remains untouched on your computer or phone. Once you close the browser tab, the cropped state is cleared from memory, so make sure to download your edits. Your original file stays exactly as it was.\"}}]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://creatorunits.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Image Tools\",\"item\":\"https://creatorunits.com/category/image\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Image Cropper\",\"item\":\"https://creatorunits.com/tools/image/image-cropper\"}]}</script><header class=\"Header-module__lnUIdW__header\" role=\"banner\"><div class=\"Header-module__lnUIdW__nav container\"><a class=\"Header-module__lnUIdW__logo\" aria-label=\"Creators Units - Go to homepage\" href=\"/\"><svg class=\"Header-module__lnUIdW__logoIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"8\" height=\"18\" rx=\"2\"></rect><rect x=\"13\" y=\"3\" width=\"8\" height=\"8\" rx=\"2\"></rect><rect x=\"13\" y=\"13\" width=\"8\" height=\"8\" rx=\"2\"></rect></svg><span class=\"Header-module__lnUIdW__logoText\">Creators Units</span></a><nav class=\"Header-module__lnUIdW__menu\" aria-label=\"Main navigation\"><a class=\"Header-module__lnUIdW__link Header-module__lnUIdW__linkActive\" aria-current=\"page\" href=\"/tools\">Explore Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/category/image\">Image Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/category/creator\">Creator Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/category/social\">Social Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/category/utility\">Utility Tools</a><a class=\"Header-module__lnUIdW__link \" href=\"/about\">About</a><a class=\"Header-module__lnUIdW__link \" href=\"/contact\">Contact</a></nav><div class=\"Header-module__lnUIdW__actions\"><button class=\"Header-module__lnUIdW__themeToggle\" aria-label=\"Switch to dark mode\" title=\"Toggle to dark theme\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"></path></svg></button><button class=\"Header-module__lnUIdW__menuToggle\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mobile-nav\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line><line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line></svg></button></div></div></header><main class=\"main-content section\" id=\"main-content\"><div class=\"container\"><nav aria-label=\"Breadcrumb\" style=\"margin-bottom:1rem;font-size:0.85rem\"><ol style=\"display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:0;align-items:center\"><li><a style=\"color:var(--text-muted);text-decoration:none\" href=\"/\">Home</a></li><li aria-hidden=\"true\" style=\"margin:0 0.5rem;color:var(--text-muted)\">/</li><li><a style=\"color:var(--text-muted);text-decoration:none\" href=\"/category/image\">Image Tools</a></li><li aria-hidden=\"true\" style=\"margin:0 0.5rem;color:var(--text-muted)\">/</li><li aria-current=\"page\" style=\"color:var(--text-primary);font-weight:600\">Image Cropper</li></ol></nav><div style=\"margin-bottom:2rem\"><h1 style=\"font-size:2.25rem;margin-bottom:0.5rem\">Image Cropper</h1><p class=\"text-muted\" style=\"font-size:1.05rem;margin:0\">Crop images to specific ratios like 16:9, 1:1, 4:3, or custom shapes instantly.</p></div><section style=\"margin-bottom:3rem\" aria-label=\"Image Cropper tool interface\"><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><!--/$--></section><div class=\"grid-cols-2\" style=\"gap:2rem;margin-bottom:3rem\"><div class=\"card\"><h2 style=\"font-size:1.25rem;margin-bottom:1rem\">📋 How to Use</h2><ol style=\"padding-left:1.25rem;display:flex;flex-direction:column;gap:0.5rem;font-size:0.9rem\"><li style=\"color:var(--text-secondary)\">Upload your image to the crop interface.</li><li style=\"color:var(--text-secondary)\">Select an aspect ratio preset or adjust the cropping frame handles manually.</li><li style=\"color:var(--text-secondary)\">Drag the crop frame over your target area.</li><li style=\"color:var(--text-secondary)\">Click &#x27;Crop &amp; Download&#x27; to export the cropped image.</li></ol></div><div class=\"card\"><h2 style=\"font-size:1.25rem;margin-bottom:1rem\">⚡ Key Features</h2><ul style=\"padding-left:1.25rem;display:flex;flex-direction:column;gap:0.5rem;font-size:0.9rem;list-style-type:square\"><li style=\"color:var(--text-secondary)\">Ratio Presets: 1:1 Square, 16:9 Widescreen, 4:3 Portrait.</li><li style=\"color:var(--text-secondary)\">Responsive crop overlays.</li><li style=\"color:var(--text-secondary)\">Zero-latency cropping using HTML5 canvas.</li></ul></div></div><section class=\"card\" style=\"background-color:var(--bg-primary);padding:2.5rem;margin-bottom:3.5rem\"><h2 style=\"font-size:1.75rem;margin-bottom:1rem\">Crop Images for Social Media &amp; Web Presets</h2><p class=\"text-muted\" style=\"font-size:1.05rem;margin-bottom:1.5rem\">Cut out unwanted edges or align your images to specific compositions using our lightweight Image Cropper.</p><div style=\"font-size:0.95rem;color:var(--text-secondary);line-height:1.75;display:flex;flex-direction:column;gap:1.25rem\">\n<h3>Improving Visual Focus with Cropping</h3>\n<p>Cropping is not just about changing size; it is about drawing attention to the subject. Remove cluttered background noise, align elements using the rule of thirds, or fit graphics to precise profile image proportions without stretching the pixels.</p>\n    </div></section><section style=\"margin-bottom:3.5rem\" aria-labelledby=\"tool-faq-heading\"><h2 id=\"tool-faq-heading\" class=\"text-center mb-6\">Frequently Asked Questions</h2><div class=\"flex flex-col gap-4\" style=\"max-width:800px;margin:0 auto\"><details class=\"card\"><summary style=\"font-size:1.05rem;font-weight:600;cursor:pointer;padding:0.5rem 0;list-style:none;display:flex;justify-content:space-between;align-items:center\">What is image cropping?<span aria-hidden=\"true\" style=\"font-size:1.25rem;color:var(--success)\">+</span></summary><p class=\"text-muted\" style=\"font-size:0.9rem;margin:0.5rem 0 0 0;padding-top:0.5rem;border-top:1px solid var(--border-color)\">Image cropping is the process of removing unwanted outer areas from a photo or graphic. It allows you to change the aspect ratio, focus on a specific subject, eliminate distracting background elements, or fit the image into a designated space without stretching or distorting the remaining visual details. It is one of the quickest ways to improve any photograph.</p></details><details class=\"card\"><summary style=\"font-size:1.05rem;font-weight:600;cursor:pointer;padding:0.5rem 0;list-style:none;display:flex;justify-content:space-between;align-items:center\">Can cropping improve image composition?<span aria-hidden=\"true\" style=\"font-size:1.25rem;color:var(--success)\">+</span></summary><p class=\"text-muted\" style=\"font-size:0.9rem;margin:0.5rem 0 0 0;padding-top:0.5rem;border-top:1px solid var(--border-color)\">Yes, cropping is a powerful tool for improving composition. By removing busy background elements, you can guide the viewer&#x27;s eye to the main subject. You can apply composition rules, like the rule of thirds, by placing key elements along the gridlines, making your photographs look more professional and engaging. A well-cropped photo instantly draws attention to what matters most.</p></details><details class=\"card\"><summary style=\"font-size:1.05rem;font-weight:600;cursor:pointer;padding:0.5rem 0;list-style:none;display:flex;justify-content:space-between;align-items:center\">How do I crop images for Instagram?<span aria-hidden=\"true\" style=\"font-size:1.25rem;color:var(--success)\">+</span></summary><p class=\"text-muted\" style=\"font-size:0.9rem;margin:0.5rem 0 0 0;padding-top:0.5rem;border-top:1px solid var(--border-color)\">Instagram supports three main aspect ratios: 1:1 for classic square posts, 4:5 for portrait feeds, and 16:9 for landscape photos. Our image cropper provides simple ratio presets. Select the preset you need, drag the cropping box over your image to frame it, and download the perfectly sized graphic. Your posts will display cleanly without unwanted borders or awkward cropping.</p></details><details class=\"card\"><summary style=\"font-size:1.05rem;font-weight:600;cursor:pointer;padding:0.5rem 0;list-style:none;display:flex;justify-content:space-between;align-items:center\">Does cropping reduce file size?<span aria-hidden=\"true\" style=\"font-size:1.25rem;color:var(--success)\">+</span></summary><p class=\"text-muted\" style=\"font-size:0.9rem;margin:0.5rem 0 0 0;padding-top:0.5rem;border-top:1px solid var(--border-color)\">Yes, cropping reduces the overall file size of an image. Because you are physically discarding pixels from the edges of the image, the total amount of pixel data decreases. When the crop is exported, the resulting file will contain fewer bytes, making it load faster on websites. This also means less bandwidth usage for your visitors.</p></details><details class=\"card\"><summary style=\"font-size:1.05rem;font-weight:600;cursor:pointer;padding:0.5rem 0;list-style:none;display:flex;justify-content:space-between;align-items:center\">Can I crop images on mobile devices?<span aria-hidden=\"true\" style=\"font-size:1.25rem;color:var(--success)\">+</span></summary><p class=\"text-muted\" style=\"font-size:0.9rem;margin:0.5rem 0 0 0;padding-top:0.5rem;border-top:1px solid var(--border-color)\">Yes, our image cropper is fully mobile-friendly. You can upload an image from your smartphone or tablet, adjust the crop box using touch controls, zoom in or out, select standard aspect ratios, and download the cropped file directly to your device&#x27;s photo library using your mobile browser. No app installation is required.</p></details><details class=\"card\"><summary style=\"font-size:1.05rem;font-weight:600;cursor:pointer;padding:0.5rem 0;list-style:none;display:flex;justify-content:space-between;align-items:center\">Is image cropping permanent?<span aria-hidden=\"true\" style=\"font-size:1.25rem;color:var(--success)\">+</span></summary><p class=\"text-muted\" style=\"font-size:0.9rem;margin:0.5rem 0 0 0;padding-top:0.5rem;border-top:1px solid var(--border-color)\">Cropping with our browser-based tool generates a new, cropped copy of your image for you to download. Your original source file remains untouched on your computer or phone. Once you close the browser tab, the cropped state is cleared from memory, so make sure to download your edits. Your original file stays exactly as it was.</p></details></div></section><section style=\"border-top:1px solid var(--border-color);padding-top:3rem\" aria-labelledby=\"related-heading\"><h2 id=\"related-heading\" class=\"mb-6\">Related <!-- -->Image Tools</h2><div class=\"grid-cols-4\"><a class=\"card card-hover flex flex-col gap-2\" style=\"text-decoration:none;color:inherit;padding:1.25rem\" aria-label=\"Open Image Compressor - Compress PNG, JPG, and WebP images directly in your browser without losing quality.\" href=\"/tools/image/image-compressor\"><h3 style=\"font-size:1rem;margin:0\">Image Compressor</h3><p class=\"text-muted\" style=\"font-size:0.8rem;margin:0;flex-grow:1;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical\">Compress PNG, JPG, and WebP images directly in your browser without losing quality.</p></a><a class=\"card card-hover flex flex-col gap-2\" style=\"text-decoration:none;color:inherit;padding:1.25rem\" aria-label=\"Open Image Resizer - Resize images to custom pixel dimensions or preset percentages with aspect ratio lock.\" href=\"/tools/image/image-resizer\"><h3 style=\"font-size:1rem;margin:0\">Image Resizer</h3><p class=\"text-muted\" style=\"font-size:0.8rem;margin:0;flex-grow:1;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical\">Resize images to custom pixel dimensions or preset percentages with aspect ratio lock.</p></a><a class=\"card card-hover flex flex-col gap-2\" style=\"text-decoration:none;color:inherit;padding:1.25rem\" aria-label=\"Open JPG to PNG Converter - Convert JPG/JPEG images to PNG format instantly while maintaining original quality.\" href=\"/tools/image/jpg-to-png-converter\"><h3 style=\"font-size:1rem;margin:0\">JPG to PNG Converter</h3><p class=\"text-muted\" style=\"font-size:0.8rem;margin:0;flex-grow:1;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical\">Convert JPG/JPEG images to PNG format instantly while maintaining original quality.</p></a><a class=\"card card-hover flex flex-col gap-2\" style=\"text-decoration:none;color:inherit;padding:1.25rem\" aria-label=\"Open PNG to WebP Converter - Convert PNG graphics to modern WebP format to reduce web loading times.\" href=\"/tools/image/png-to-webp-converter\"><h3