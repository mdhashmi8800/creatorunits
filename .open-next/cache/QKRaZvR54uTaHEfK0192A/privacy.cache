\",{\"name\":\"description\",\"content\":\"Read our Privacy Policy. All tools run client-side; we never collect or store your uploaded images or data.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"Creators Units\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"creator tools, image compressor, qr generator, youtube tag extractor, text case converter, fancy text generator, link in bio\"}],[\"$\",\"meta\",\"4\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"5\",{\"rel\":\"canonical\",\"href\":\"https://creatorunits.com/privacy\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Privacy Policy - Creators Units\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Read our Privacy Policy. All tools run client-side; we never collect or store your uploaded images or data.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://creatorunits.com/og-image.png\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"Creators Units - Free Online Tools for Creators & Social Media\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"Free, fast, and SEO-friendly tools for YouTubers, Instagram creators, WhatsApp users, freelancers, and small businesses.\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:image\",\"content\":\"https://creatorunits.com/og-image.png\"}],[\"$\",\"link\",\"13\",{\"rel\":\"icon\",\"href\":\"/icon.svg\"}],[\"$\",\"link\",\"14\",{\"rel\":\"apple-touch-icon\",\"href\":\"/icon.svg\"}],[\"$\",\"$L23\",\"15\",{}]]\n22:null\n","/privacy/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[3374,[\"/_next/static/chunks/119u6-1buly1t.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/2kxn0_3njqx6v.js\"],\"default\"]\nb:I[22016,[\"/_next/static/chunks/119u6-1buly1t.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/2kxn0_3njqx6v.js\"],\"\"]\nc:I[97367,[\"/_next/static/chunks/119u6-1buly1t.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\"],\"OutletBoundary\"]\nd:\"$Sreact.suspense\"\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"$L2\",null,{}],[\"$\",\"main\",null,{\"className\":\"main-content section\",\"id\":\"main-content\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"style\":{\"maxWidth\":\"800px\"},\"children\":[[\"$\",\"h1\",null,{\"className\":\"mb-6\",\"children\":\"Privacy Policy\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-5\",\"style\":{\"fontSize\":\"0.95rem\",\"color\":\"var(--text-secondary)\",\"lineHeight\":\"1.75\"},\"children\":[[\"$\",\"p\",null,{\"children\":\"At Creators Units, accessible from creatorunits.com, one of our main priorities is the privacy of our visitors. This Privacy Policy document contains types of information that is collected and recorded by Creators Units and how we use it.\"}],[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"1.35rem\",\"color\":\"var(--text-primary)\",\"marginTop\":\"1rem\",\"margin\":\"0\"},\"children\":\"1. Client-Side Operations & Data Isolation\"}],[\"$\",\"p\",null,{\"children\":\"Unlike standard tools that require uploading your graphics, code scripts, or documents, Creators Units performs all operations locally in your browser memory. Any file you drag-and-drop (including images, screenshots, thumbnails, or Wi-Fi configurations) never leaves your device. No server uploads occur. Consequently, we do not inspect, log, store, or sell any of your media assets.\"}],[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"1.35rem\",\"color\":\"var(--text-primary)\",\"marginTop\":\"1rem\",\"margin\":\"0\"},\"children\":\"2. Log Files\"}],[\"$\",\"p\",null,{\"children\":\"Creators Units follows a standard procedure of using log files. These files log visitors when they visit websites. All hosting companies do this as part of hosting services' analytics. The information collected by log files includes internet protocol (IP) addresses, browser type, Internet Service Provider (ISP), date and time stamp, referring/exit pages, and possibly the number of clicks. These are not linked to any information that is personally identifiable. The purpose of the information is for analyzing trends, administering the site, tracking users' movement on the website, and gathering demographic information.\"}],[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"1.35rem\",\"color\":\"var(--text-primary)\",\"marginTop\":\"1rem\",\"margin\":\"0\"},\"children\":\"3. Cookies and Web Beacons\"}],[\"$\",\"p\",null,{\"children\":\"Like any other website, Creators Units uses cookies. These cookies are used to store information including visitors' preferences, and the pages on the website that the visitor accessed or visited. The information is used to optimize the users' experience by customizing our web page content based on visitors' browser type and/or other information. You can configure your browser settings to reject cookies if preferred.\"}],[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"1.35rem\",\"color\":\"var(--text-primary)\",\"marginTop\":\"1rem\",\"margin\":\"0\"},\"children\":\"4. Google DoubleClick DART Cookie\"}],[\"$\",\"p\",null,{\"children\":\"Google is one of the third-party vendors on our site. It also uses cookies, known as DART cookies, to serve ads to our site visitors based upon their visit to our site and other sites on the internet. However, visitors may choose to decline the use of DART cookies by visiting the Google ad and content network Privacy Policy at the following URL: https://policies.google.com/technologies/ads\"}],[\"$\",\"h2\",null,{\"style\":{\"fontSize\":\"1.35rem\",\"color\":\"var(--text-primary)\",\"marginTop\":\"1rem\",\"margin\":\"0\"},\"children\":\"5. Consent\"}],[\"$\",\"p\",null,{\"children\":\"By using our website, you hereby consent to our Privacy Policy and agree to its terms.\"}]]}]]}]}],[\"$\",\"footer\",null,{\"className\":\"Footer-module__3hUVsW_