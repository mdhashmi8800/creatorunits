\"fontSize\":\"1.75rem\",\"marginBottom\":\"1rem\"},\"children\":\"Mirror and Flip Graphics and Selfies Free\"}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"1.05rem\",\"marginBottom\":\"1.5rem\"},\"children\":\"Flip selfies taken with front-facing camera lenses or create mirror compositions using our offline-ready Image Flipper.\"}],[\"$\",\"div\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"\\n<h3>Fixing Mirrored Camera Selfies</h3>\\n<p>Many front-facing smartphone cameras mirror images automatically. This can make text in the background look reversed or feel unnatural. Flipper solves this by mirroring the pixel matrix horizontally, returning text to legible orientations.</p>\\n    \"},\"style\":{\"fontSize\":\"0.95rem\",\"color\":\"var(--text-secondary)\",\"lineHeight\":\"1.75\",\"display\":\"flex\",\"flexDirection\":\"column\",\"gap\":\"1.25rem\"}}]]}],[\"$\",\"section\",null,{\"style\":{\"marginBottom\":\"3.5rem\"},\"aria-labelledby\":\"tool-faq-heading\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"tool-faq-heading\",\"className\":\"text-center mb-6\",\"children\":\"Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4\",\"style\":{\"maxWidth\":\"800px\",\"margin\":\"0 auto\"},\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"What does image flipping do?\",\"$L20\"]}],\"$L21\"]}],\"$L22\",\"$L23\",\"$L24\",\"$L25\"]}]]}],\"$L26\"]}]}]\n1e:[\"$\",\"footer\",null,{\"className\":\"Footer_footer__eNA9m\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"Footer_grid__WCfx6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"Footer_brandCol__6UIwg\",\"children\"