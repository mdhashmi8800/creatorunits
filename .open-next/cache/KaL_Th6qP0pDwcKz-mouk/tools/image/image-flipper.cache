className\":\"Footer_link___mmVB\",\"children\":\"All Tools\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L8\",null,{\"href\":\"/about\",\"className\":\"Footer_link___mmVB\",\"children\":\"About Us\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L8\",null,{\"href\":\"/contact\",\"className\":\"Footer_link___mmVB\",\"children\":\"Contact Form\"}]}]]}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"Footer_colTitle__u3AX5\",\"children\":\"Legal\"}],[\"$\",\"ul\",null,{\"className\":\"Footer_linkList__K_ONQ\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L8\",null,{\"href\":\"/privacy\",\"className\":\"Footer_link___mmVB\",\"children\":\"Privacy Policy\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L8\",null,{\"href\":\"/terms\",\"className\":\"Footer_link___mmVB\",\"children\":\"Terms of Service\"}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L8\",null,{\"href\":\"/disclaimer\",\"className\":\"Footer_link___mmVB\",\"children\":\"Disclaimer\"}]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"Footer_bottom__ch0uR\",\"children\":[[\"$\",\"div\",null,{\"className\":\"Footer_copyright__vFlrA\",\"children\":[\"© \",2026,\" Creators Units. All rights reserved. Built for creators, bloggers, and small businesses.\"]}],[\"$\",\"div\",null,{\"className\":\"Footer_bottomLinks__ZM1Vi\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/privacy\",\"className\":\"Footer_bottomLink__Oi1xO\",\"children\":\"Privacy\"}],[\"$\",\"$L8\",null,{\"href\":\"/terms\",\"className\":\"Footer_bottomLink__Oi1xO\",\"children\":\"Terms\"}],[\"$\",\"$L8\",null,{\"href\":\"/disclaimer\",\"className\":\"Footer_bottomLink__Oi1xO\",\"children\":\"Disclaimer\"}]]}]]}]]}]}]\n20:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]\n21:[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"Image flipping mirrors the pixel layout of an image across a central axis. Unlike rotation, which turns the image around a center point, flipping reverses the content. This is useful for mirroring selfies, creating symmetric design layouts, correcting text direction, or adjusting the visual flow of a composition. It opens up creative possibilities that rotation alone cannot achieve.\"}]\n22:[\"$\",\"details\",\"1\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"What is the difference between horizontal and vertical flip?\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"A horizontal flip mirrors the image from left to right, reversing the horizontal axis. This is perfect for correcting front-facing camera selfies. A vertical flip mirrors the image from top to bottom, making the content appear upside down. It is often used for creative reflections or water effect graphics. Understanding the difference helps you choose the right flip for your needs.\"}]]}]\n23:[\"$\",\"details\",\"2\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"Can I undo a flip?\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"Yes, undoing a flip is simple. If you apply a horizontal or vertical flip and want to revert, just click the corresponding flip button a second time. This restores the pixel coordinates to their original layout, allowing you to preview different configurations without any risk. You can experiment freely since nothing is permanent until you download.\"}]]}]\n24:[\"$\",\"details\",\"3\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"Does flipping affect image quality?\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"No, flipping your images does not reduce quality. The mirroring calculations are processed losslessly using the HTML5 Canvas API in your browser. The pixels are flipped mathematically across the axis, preserving the original resolution, file format parameters, and compression quality settings of your source file. The flipped output will be pixel-perfect.\"}]]}]\n25:[\"$\",\"details\",\"4\",{\"className\":\"card\",\"children\":[[\"$\",\"summary\",null,{\"style\":{\"fontSize\":\"1.05rem\",\"fontWeight\":\"600\",\"cursor\":\"pointer\",\"padding\":\"0.5rem 0\",\"listStyle\":\"none\",\"display\":\"flex\",\"justifyContent\":\"space-between\",\"alignItems\":\"center\"},\"children\":[\"When is image flipping useful?\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"style\":{\"fontSize\":\"1.25rem\",\"color\":\"var(--success)\"},\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.9rem\",\"margin\":\"0.5rem 0 0 0\",\"paddingTop\":\"0.5rem\",\"borderTop\":\"1px solid var(--border-color)\"},\"children\":\"Flipping is useful for correcting mirrored text in selfies, creating artistic symmetry, and adjusting character gaze in web design. For example, if a person in a photo is looking away from your call-to-action text, flipping them horizontally can direct their gaze toward the message. It is a subtle technique that can significantly improve how viewers engage with your content.\"}]]}]\n26:[\"$\",\"section\",null,{\"style\":{\"borderTop\":\"1px solid var(--border-color)\",\"paddingTop\":\"3rem\"},\"aria-labelledby\":\"related-heading\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"related-heading\",\"className\":\"mb-6\",\"children\":[\"Related \",\"Image Tools\"]}],[\"$\",\"div\",null,{\"className\":\"grid-cols-4\",\"children\":[[\"$\",\"$L8\",\"img-compressor\",{\"href\":\"/tools/image/image-compressor\",\"className\":\"card card-hover flex flex-col gap-2\",\"style\":{\"textDecoration\":\"none\",\"color\":\"inherit\",\"padding\":\"1.25rem\"},\"aria-label\":\"Open Image Compressor - Compress PNG, JPG, and WebP images directly in your browser without losing quality.\",\"children\":[[\"$\",\"h3\",null,{\"style\":{\"fontSize\":\"1rem\",\"margin\":0},\"children\":\"Image Compressor\"}],[\"$\",\"p\",null,{\"className\":\"text-muted\",\"style\":{\"fontSize\":\"0.8rem\",\"margin\":0,\"flexGrow\":1,\"overflow\":\"hidden\",\"textOverflow\":\"ellipsis\",\"display\":\"-webkit-box\",\"WebkitLineClamp\":2,\"WebkitBoxOrient\":\"vertical\"},\"children\":\"Compress PNG, JPG, and WebP images directly in your browser without losing quality.\"}]]}],[\"$\",\"$L8\",\"img-resizer\",{\"href\":\"/tools/image/image-resizer\",\"className\":\"card card-hov